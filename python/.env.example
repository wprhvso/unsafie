HOST=127.0.0.1
PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unsafie
DB_USER=unsafie
DB_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=unsafie
UNSAFIE_ROLE=all
LOG_LEVEL=INFO
GITHUB_CACHE_DIR=/var/lib/unsafie/cache
PUBLIC_BASE_URL=https://unsafie.com
GITHUB_BASE_URL=https://github.unsafie.com
ARTIFACT_BASE_URL=https://unsafie.com
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
ADMIN_TOKEN=
ADMIN_SESSION_DAYS=30
STATIC_DIR=/var/lib/unsafie/src/svelte/build
FLUENT_DIR=/var/lib/unsafie/src/fluent
CLAUDE_THINKING=adaptive
# what the API sends back for thinking blocks: summarized — a summary of the reasoning,
# the only mode with readable text; updates — progress notes only, blocks come back empty;
# omitted — nothing at all; off — the field is not sent. Raw reasoning is not available.
CLAUDE_THINKING_DISPLAY=updates
CLAUDE_CLEAR_THINKING=1
CLAUDE_CLEAR_THINKING_KEEP=all
CLAUDE_FALLBACKS=default

# live view of a running turn at {ARTIFACT_BASE_URL}/<slug>: the slug is a turn artifact,
# the stream behind it lives in redis only and expires with LIVE_TTL.
LIVE_ENABLED=1
LIVE_TTL=86400
LIVE_IMAGES=1

# conversation history kept as one segment per turn
HISTORY_MAX_BYTES=33554432
HISTORY_KEEP_DAYS=30
LINEAGE_DEPTH=500

# tracing (VictoriaTraces); OTEL_ENABLED=0 turns everything off
OTEL_ENABLED=1
OTEL_ENDPOINT=http://127.0.0.1:4317
OTEL_PROTOCOL=grpc
OTEL_SAMPLE_RATIO=1.0
OTEL_CAPTURE_CONTENT=0
ENVIRONMENT=dev
