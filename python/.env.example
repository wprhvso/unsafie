HOST=127.0.0.1
PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unsafie
DB_USER=unsafie
DB_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=unsafie
UNSAFIE_ROLE=all
LOG_LEVEL=INFO
GITHUB_CACHE_DIR=/var/lib/unsafie/cache
PUBLIC_BASE_URL=https://unsafie.com
GITHUB_BASE_URL=https://github.unsafie.com
ARTIFACT_BASE_URL=https://unsafie.com
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=UTC
ADMIN_TOKEN=
ADMIN_SESSION_DAYS=30
STATIC_DIR=/var/lib/unsafie/src/svelte/build
FLUENT_DIR=/var/lib/unsafie/src/fluent

GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_API_URL=https://appcatalyst.pa.googleapis.com/v1beta1/models
OPAL_REFRESH_URL=https://opal.google/connection/refresh
OPAL_ACCESS_TTL=2700
OPAL_PICK_ATTEMPTS=3
GEMINI_SAFETY_THRESHOLD=BLOCK_NONE
GEMINI_THINKING_LEVEL=HIGH

LIVE_ENABLED=1
LIVE_TTL=86400
LIVE_IMAGES=1

HISTORY_MAX_BYTES=33554432
HISTORY_KEEP_DAYS=30
LINEAGE_DEPTH=500

OTEL_ENABLED=1
OTEL_ENDPOINT=http://127.0.0.1:4317
OTEL_PROTOCOL=grpc
OTEL_SAMPLE_RATIO=1.0
OTEL_CAPTURE_CONTENT=0
ENVIRONMENT=dev
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
EMAIL_WEBHOOK_SECRET=
