[Unit]
Description=unsafie relay (zig)
After=network-online.target
PartOf=unsafie.target

[Service]
Type=exec
User=unsafie
Group=unsafie
EnvironmentFile=/etc/unsafie/cluster.env
Environment=RELAY_PORT=8080
Environment=RELAY_PATH=/api/v1/events
Environment=RELAY_PSK={{ vault_relay_psk | default('') }}
ExecStart=/usr/local/bin/unsafie-relay
Restart=always
RestartSec=2
MemoryMax=64M
CPUWeight=150
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=unsafie.target
