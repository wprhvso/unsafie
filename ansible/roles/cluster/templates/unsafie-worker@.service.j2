[Unit]
Description=unsafie worker %i
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=unsafie.target

[Service]
Type=exec
User=unsafie
Group=unsafie
EnvironmentFile=/etc/unsafie/app.env
EnvironmentFile=/etc/unsafie/cluster.env
Environment=HOME=/var/lib/unsafie
ExecStart=/usr/local/bin/unsafie-exec worker %i
Restart=always
RestartSec=2
TimeoutStopSec=900
KillMode=mixed
MemoryHigh=1000M
MemoryMax=1200M
CPUWeight=100
OOMPolicy=stop
LogExtraFields=UNSAFIE_ROLE=worker
LogExtraFields=UNSAFIE_INSTANCE=%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/unsafie

[Install]
WantedBy=unsafie.target
