server {
    listen 80;
    server_name {{ dumbvpn_domain }};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name {{ dumbvpn_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ dumbvpn_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ dumbvpn_domain }}/privkey.pem;
    access_log /var/log/nginx/access.log main buffer=16k flush=5s;

    location /api/ {
        proxy_pass http://{{ dumbvpn_update_addr }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_max_temp_file_size 0;
    }

    location = {{ dumbvpn_hook_path }} {
        proxy_pass http://{{ dumbvpn_hook_addr }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        client_max_body_size 2m;
    }

    location / { return 444; }
}
