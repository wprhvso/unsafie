#!/usr/bin/env bash
set -euo pipefail

ref="${1:?ref or commit}"

root="{{ dumbvpn_home }}"
src="$root/src"
releases="$root/releases"
logs="$root/logs"
workroot="$root/work"
lock="$root/build.lock"

repo="${DUMBVPN_REPO:?}"
branch="${DUMBVPN_BRANCH:-main}"
keep="${DUMBVPN_KEEP_RELEASES:-5}"
details_url="${DUMBVPN_DETAILS_URL:-}"

export HOME="$root"
export GOPATH="$root/go"
export GOCACHE="$root/cache/go-build"
export GOFLAGS="-mod=mod"
export GOTOOLCHAIN=local
export GRADLE_USER_HOME="$root/cache/gradle"
export GRADLE_OPTS="-Dorg.gradle.daemon=false"
export JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
export ANDROID_HOME="{{ dumbvpn_android_sdk }}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export ANDROID_NDK_ROOT="$ANDROID_HOME/ndk/{{ dumbvpn_android_ndk }}"
export ANDROID_NDK_HOME="$ANDROID_NDK_ROOT"
export PATH="/usr/local/go/bin:$GOPATH/bin:/opt/gradle/bin:$ANDROID_HOME/platform-tools:/usr/local/bin:/usr/bin:/bin"

mkdir -p "$logs" "$workroot" "$root/cache"

exec 9>"$lock"
flock 9

log() { printf '%s %s\n' "$(date -u +%H:%M:%S)" "$*"; }

hook_bin=""
hook() {
    local bin="$hook_bin"
    if [ -z "$bin" ] && [ -x /usr/local/bin/dumbvpn-hook ]; then
        bin=/usr/local/bin/dumbvpn-hook
    fi
    if [ -z "$bin" ]; then
        return 0
    fi
    "$bin" "$@"
}

git_auth=()
if [ -n "${GITHUB_APP_ID:-}" ]; then
    token=""
    if [ -x /usr/local/bin/dumbvpn-hook ]; then
        token="$(hook token 2>/dev/null || true)"
    fi
    if [ -z "$token" ]; then
        token="$(/usr/local/bin/dumbvpn-token 2>/dev/null || true)"
    fi
    if [ -n "$token" ]; then
        auth="$(printf 'x-access-token:%s' "$token" | base64 -w0)"
        git_auth=(-c "http.extraheader=AUTHORIZATION: basic $auth")
    else
        log "no installation token; fetching anonymously"
    fi
fi
git_remote() { git -C "$src" "${git_auth[@]}" "$@"; }

if [ ! -d "$src/.git" ]; then
    log "cloning $repo"
    git "${git_auth[@]}" clone --no-checkout "$repo" "$src"
fi
git_remote fetch --prune --tags origin "+refs/heads/$branch:refs/remotes/origin/$branch"

if [ "$ref" = "$branch" ] || [ "$ref" = "main" ]; then
    ref="origin/$branch"
fi
sha="$(git -C "$src" rev-parse --verify "${ref}^{commit}")"
tip="$(git -C "$src" rev-parse --verify "origin/$branch^{commit}")"

if ! git -C "$src" merge-base --is-ancestor "$sha" "$tip"; then
    log "$sha is not on $branch; refusing to build it"
    exit 1
fi

git -C "$src" checkout --quiet --detach "$sha"
git -C "$src" clean -fdq

logfile="$logs/$sha.log"
: >"$logfile"
exec > >(tee -a "$logfile") 2>&1

work="$workroot/$sha"
rm -rf "$work"
mkdir -p "$work/bin" "$work/dist"

check_id=""
if [ -n "${GITHUB_APP_ID:-}" ]; then
    if id="$(hook check start -sha "$sha" -url "$details_url")" && [[ "$id" =~ ^[0-9]+$ ]]; then
        check_id="$id"
        log "check run $check_id created"
    else
        log "check run not created"
    fi
fi

summary=()
conclusion=failure
title="build failed"

finish() {
    local code=$?
    if [ "$code" -eq 0 ]; then
        conclusion=success
        title="built ${version:-?}"
    fi
    if [ -n "$check_id" ]; then
        hook check finish -id "$check_id" -conclusion "$conclusion" \
            -title "$title" -summary "$(printf '%s\n' "${summary[@]:-}")" -log "$logfile" ||
            log "could not finish check run $check_id"
    fi
    rm -rf "$work"
    exit "$code"
}
trap finish EXIT

version="$(sed -n 's/.*versionName "\(.*\)".*/\1/p' "$src/android/app/build.gradle")"
if [ -z "$version" ]; then
    log "cannot read versionName from android/app/build.gradle"
    exit 1
fi
case "$version" in
*-*) prerelease=true ;;
*) prerelease=false ;;
esac
log "building $sha as v$version (tip of $branch: $tip)"

cd "$src"

RELEASE_PUBKEY="$(sed -n 's/^[[:space:]]*RELEASE_PUB[[:space:]]*=[[:space:]]*//p' "$src/.env" | head -n1 | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//')"
if [ -z "$RELEASE_PUBKEY" ]; then
    log "cannot read RELEASE_PUB from .env"
    exit 1
fi
export RELEASE_PUBKEY

VERSION="v$version" just check-version

log "server binaries"
just build-server "$work/bin"
hook_bin="$work/bin/dumbvpn-hook"

log "tests"
just test
just vet

log "windows"
VERSION="v$version" just build-windows-amd64
mv "$src/dumbvpn-v$version-amd64.exe" "$work/dist/"

log "android"
VERSION="v$version" just build-android
mv "$src"/android/app/build/outputs/apk/release/dumbvpn-v"$version"-*.apk "$work/dist/"
gradle -p android --quiet test

log "signing"
VERSION="v$version" just sign "$work/dist"

printf '%s\n' "$sha" >"$work/dist/commit"
summary+=("commit \`$sha\`, version \`$version\`")

if [ "$sha" != "$tip" ]; then
    summary+=("not the tip of $branch: built and verified, nothing deployed")
    log "$sha is behind $tip; not deploying"
    exit 0
fi

log "activating server binaries"
if ! /usr/local/bin/dumbvpn-activate "$work"; then
    code=$?
    log "activate failed with code $code"
    exit 1
fi
summary+=("server binaries installed from this commit")

if [ -d "$releases/$version" ]; then
    previous="$(cat "$releases/$version/commit" 2>/dev/null || echo unknown)"
    summary+=("v$version was already published from \`$previous\`; bump the version to ship clients")
    log "v$version already published; clients unchanged"
else
    chmod -R a+rX "$work/dist"
    mv "$work/dist" "$releases/$version"
    summary+=("v$version published: $(ls "$releases/$version" | grep -v '\.sig$' | grep -v '^commit$' | tr '\n' ' ')")
    if [ "$prerelease" = true ]; then
        summary+=("prerelease: downloadable, not offered to clients")
    else
        tmp="$(mktemp "$releases/.current.XXXXXX")"
        printf '%s\n' "$version" >"$tmp"
        chmod 0644 "$tmp"
        mv -f "$tmp" "$releases/current"
        ln -sfn "$version" "$releases/latest"
        summary+=("clients are now offered v$version")
    fi
    if [ -n "${GITHUB_APP_ID:-}" ]; then
        if hook tag -name "v$version" -sha "$sha"; then
            summary+=("tagged v$version")
        else
            summary+=("could not tag v$version")
        fi
    fi
fi

current="$(cat "$releases/current" 2>/dev/null || true)"
ls -1t "$releases" | grep -E '^[0-9]' | grep -vx "$current" | tail -n +"$((keep + 1))" | while read -r old; do
    log "pruning old release $old"
    rm -rf "${releases:?}/$old"
done

log "done"
