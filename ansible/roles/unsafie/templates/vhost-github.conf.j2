# managed by ansible
# Only the GitHub App endpoints live here; everything else is refused.
server {
    listen 80;
    listen [::]:80;
    server_name {{ unsafie_github_domain }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ unsafie_github_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ unsafie_github_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ unsafie_github_domain }}/privkey.pem;

    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;

    location ~ "^/gh/(webhook|oauth|app/(new|created))$" {
        proxy_pass http://{{ unsafie_host }}:{{ unsafie_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        return 444;
    }
}
