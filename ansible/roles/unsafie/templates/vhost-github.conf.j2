# managed by ansible
# Only the GitHub App endpoints live here; everything else is refused.
server {
    listen 80;
    server_name {{ unsafie_github_domain }};

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ unsafie_github_domain }};

    include {{ tls_snippet }};

    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;

    location ~ "^/gh/(webhook|app/(new|created))$" {
        proxy_pass http://{{ unsafie_host }}:{{ unsafie_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # The id nginx already writes into the access log; the app puts it on the span.
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 60s;
    }

    location / {
        return 444;
    }
}
