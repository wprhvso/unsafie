# managed by ansible
HOST={{ unsafie_host }}
PORT={{ unsafie_port }}
LOG_LEVEL={{ unsafie_log_level }}

DB_HOST=localhost
DB_PORT=5432
DB_NAME={{ unsafie_db_name }}
DB_USER={{ unsafie_db_user }}
DB_PASSWORD=

REDIS_URL={{ unsafie_redis_url }}
REDIS_PREFIX={{ unsafie_redis_prefix }}
UNSAFIE_ROLE={{ unsafie_role }}
SHUTDOWN_GRACE={{ unsafie_shutdown_grace }}

CHATS_DIR={{ unsafie_home }}/chats
CLAUDE_CONFIG_DIR={{ unsafie_home }}/claude
GITHUB_CACHE_DIR={{ unsafie_cache_dir }}

PUBLIC_BASE_URL=https://{{ unsafie_domain }}
ARTIFACT_BASE_URL=https://{{ unsafie_domain }}
GITHUB_BASE_URL=https://{{ unsafie_github_domain }}
STATIC_DIR={{ unsafie_src }}/svelte/build
FLUENT_DIR={{ unsafie_src }}/fluent

POOL_ENABLED={{ 1 if unsafie_pool_enabled else 0 }}
POOL_BLOB_DIR={{ unsafie_home }}/pool-blobs
POOL_MAX_MACHINES={{ unsafie_pool_max_machines }}
POOL_LEASE_IDLE={{ unsafie_pool_lease_idle }}
POOL_LAUNCH_BURST={{ unsafie_pool_launch_burst }}
POOL_CI_ENABLED={{ 1 if unsafie_pool_ci_enabled else 0 }}
POOL_CI_RESERVE={{ unsafie_pool_ci_reserve }}
POOL_SDK_SPEC={{ unsafie_pool_sdk_spec }}
POOL_WIRE_SPEC={{ unsafie_pool_wire_spec }}

DEFAULT_LOCALE={{ unsafie_default_locale }}
DEFAULT_TIMEZONE={{ unsafie_default_timezone }}
ADMIN_TOKEN={{ unsafie_admin_token }}

SERVICE_NAME={{ unsafie_service_name }}
SERVICE_VERSION={{ unsafie_checkout.after | default('') | truncate(12, true, '') }}
ENVIRONMENT={{ unsafie_environment }}
OTEL_ENABLED={{ 1 if unsafie_otel_enabled else 0 }}
OTEL_ENDPOINT={{ unsafie_otel_endpoint }}
OTEL_PROTOCOL={{ unsafie_otel_protocol }}
OTEL_SAMPLE_RATIO={{ unsafie_otel_sample_ratio }}
OTEL_CAPTURE_CONTENT={{ 1 if unsafie_otel_capture_content else 0 }}
