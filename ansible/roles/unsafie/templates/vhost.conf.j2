# managed by ansible
server {
    listen 80;
    server_name {{ unsafie_domain }};

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ unsafie_domain }};

    include {{ tls_snippet }};

    root {{ unsafie_src }}/svelte/build;
    index index.html;

    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Other roles hang their own locations off the main domain: the dumbvpn
    # artifact store is one of them, and it has no business being a subdomain.
    include /etc/nginx/snippets/{{ unsafie_domain }}/*.conf;

    location /_app/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/admin/events {
        proxy_pass http://{{ unsafie_host }}:{{ unsafie_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding off;
    }

    location /api/ {
        proxy_pass http://{{ unsafie_host }}:{{ unsafie_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # The id nginx already writes into the access log; the app puts it on the span.
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }

    location ~ "^/[A-Z]{12}$" {
        proxy_pass http://{{ unsafie_host }}:{{ unsafie_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /health {
        proxy_pass http://{{ unsafie_host }}:{{ unsafie_port }};
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
