err-trace = [trace_id=<code>{ $trace_id }</code>]

err-generic = از سمت ما مشکلی پیش آمد. لطفاً دوباره تلاش کنید
err-empty = مدل پاسخ خالی برگرداند. لطفاً دوباره تلاش کنید
err-timeout = پاسخ بیش از حد طول کشید و نیمه‌کاره ماند. درخواست کوتاه‌تری بفرستید
err-storage = ذخیرهٔ گفتگو ممکن نشد — پایگاه داده در دسترس نیست

err-gateway-unreachable = درگاه هوش مصنوعی پاسخ نمی‌دهد. یک دقیقهٔ دیگر دوباره تلاش کنید
err-gateway-auth = ربات در درگاه هوش مصنوعی احراز هویت نشده است
err-gateway-capacity = همهٔ نشست‌های مدل مشغول یا منقضی شده‌اند. چند دقیقهٔ دیگر دوباره تلاش کنید

err-rate-limit = ارائه‌دهندهٔ مدل در حال حاضر تعداد درخواست‌های ما را محدود کرده است. یک دقیقهٔ دیگر دوباره تلاش کنید
err-upstream-auth = درگاه نتوانست نزد ارائه‌دهندهٔ مدل احراز هویت کند
err-upstream-unavailable = ارائه‌دهندهٔ مدل موقتاً در دسترس نیست. چند دقیقهٔ دیگر دوباره تلاش کنید
err-upstream-timeout = مدل به‌موقع پاسخ نداد. درخواست کوتاه‌تری بفرستید
err-upstream-unreachable = دسترسی به ارائه‌دهندهٔ مدل ممکن نشد — درخواست شبکه ناموفق بود
err-upstream-rejected = ارائه‌دهندهٔ مدل درخواست را نامعتبر دانست و رد کرد

err-context-length = گفتگو طولانی‌تر از آن است که مدل بتواند بخواند. گفتگوی تازه‌ای شروع کنید یا متن کوتاه‌تری بفرستید
err-content-filter = مدل متوقف شد: فیلترهای ایمنی‌اش پاسخ را مسدود کردند
err-prompt-blocked = مدل از پاسخ دادن خودداری کرد: فیلترهای ایمنی‌اش درخواست را مسدود کردند
err-model-not-found = مدل انتخاب‌شده در دسترس نیست. یکی دیگر را انتخاب کنید: { "\u200E" }/gemini31 یا { "\u200E" }/gemini3f
err-unsupported-content = این قالب پیوست پشتیبانی نمی‌شود

err-retry = 🔄 تلاش دوباره
err-retry-gone = دیگر چیزی برای تلاش دوباره نمانده است — پیام را دوباره بفرستید

chat-unsupported = فقط پیام‌های متنی پشتیبانی می‌شوند

chat-document-unreadable = نتوانستم این فایل را بخوانم
