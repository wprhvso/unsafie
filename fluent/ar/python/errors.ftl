err-trace = [trace_id=<code>{ $trace_id }</code>]

err-generic = حدث خلل من جهتنا. حاول مرة أخرى من فضلك
err-empty = أعاد النموذج ردًا فارغًا. حاول مرة أخرى من فضلك
err-timeout = استغرق الرد وقتًا أطول من اللازم فانقطع. جرّب طلبًا أقصر
err-storage = تعذّر حفظ المحادثة — قاعدة البيانات غير متاحة

err-gateway-unreachable = بوابة الذكاء الاصطناعي لا تستجيب. حاول بعد دقيقة
err-gateway-auth = البوت غير مصرّح له في بوابة الذكاء الاصطناعي
err-gateway-capacity = كل جلسات النموذج مشغولة أو منتهية الصلاحية. حاول بعد بضع دقائق

err-rate-limit = يحدّ مزوّد النموذج من عدد طلباتنا في الوقت الحالي. حاول بعد دقيقة
err-upstream-auth = تعذّر على البوابة إثبات هويتها لدى مزوّد النموذج
err-upstream-unavailable = مزوّد النموذج غير متاح مؤقتًا. حاول بعد بضع دقائق
err-upstream-timeout = لم يرد النموذج في الوقت المحدد. جرّب طلبًا أقصر
err-upstream-unreachable = تعذّر الوصول إلى مزوّد النموذج — فشل طلب الشبكة
err-upstream-rejected = رفض مزوّد النموذج الطلب باعتباره غير صالح

err-context-length = المحادثة أطول مما يستطيع النموذج قراءته. ابدأ محادثة جديدة أو أرسل نصًا أقصر
err-content-filter = توقف النموذج: حجبت مرشحات الأمان لديه الرد
err-prompt-blocked = رفض النموذج الإجابة: حجبت مرشحات الأمان لديه الطلب
err-model-not-found = النموذج المختار غير متاح. اختر غيره: { "\u200E" }/gemini31 أو { "\u200E" }/gemini3f
err-unsupported-content = صيغة المرفق هذه غير مدعومة

err-retry = 🔄 إعادة المحاولة
err-retry-gone = لم يعد هناك ما تُعاد محاولته — أرسل الرسالة مرة أخرى

chat-unsupported = لا تُدعم سوى الرسائل النصية

chat-document-unreadable = تعذّرت قراءة هذا الملف
