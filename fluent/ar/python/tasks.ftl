tasks-empty = لا توجد مهام مجدولة في هذه المحادثة.
tasks-in = خلال { $left }
tasks-now = الآن
tasks-cron = كرون «{ $expr }»
tasks-every = كل { $interval }
tasks-runs = { $n ->
    [one] عَمِلَ مرة واحدة
    [two] عَمِلَ مرتين
    [few] عَمِلَ { $n } مرات
   *[other] عَمِلَ { $n } مرة
}
tasks-paused = متوقف مؤقتًا
tasks-reminder = ⏰ { $text }
tasks-watches = مراقبة الخوادم:
tasks-hint = اطلب بكلمات بسيطة إضافة أو إزالة موعد وسأقوم بجدولته بنفسي.
tasks-cleared = تم حذف: { $tasks } مهمة مجدولة، { $watches } مراقبة.
tz-current = المنطقة الزمنية: { $name }. الوقت المحلي الآن { $now }. للتغيير: /tz Asia/Riyadh
tz-set = تم ضبط المنطقة الزمنية: { $name }. الوقت المحلي الآن { $now }.
